
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | HariOm SmartMart</title>

  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="../css/style.css">
</head>
<body>

<div class="top-bar">

  <div class="top-left">
    <img src="../image/Logo.png" class="logo-img">
    <div>
      <div class="brand-name">HariOm <span>SmartMart</span></div>
      <div class="brand-sub">Admin Dashboard</div>
    </div>
  </div>

  <div class="top-center">
    <a class="pill-btn" href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
    <a class="pill-btn" href="/admin/products"><i class="fa-solid fa-box"></i> Products</a>
    <a class="pill-btn" href="/admin/categories"><i class="fa-solid fa-list"></i> Categories</a>
     <a class="pill-btn" href="/admin/coupons">
      <i class="fa-solid fa-ticket"></i> Coupons
    </a>
    <a class="pill-btn" href="/admin/order"><i class="fa-solid fa-receipt"></i> Orders</a>
    <a class="pill-btn" href="/admin/wholesalers"><i class="fa-solid fa-truck"></i> Wholesalers</a>
        <a class="pill-btn" href="/admin/chats"><i class="fa-solid fa-headset"></i>Chat</a>
  </div>

  <div class="top-right">
  <button class="login-btn" onclick="location.href='/'">
       <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
    </button>
    </div>
</div>

</body>
</html>
