</div>


</div>




<footer class="site-footer">
  <div class="footer-bottom">
    © 2025 HariOm SmartMart | Admin Panel
  </div>
</footer>




</body>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
let salesChart;

const ctx = document.getElementById('salesChart').getContext('2d');

function createGradient(ctx) {
  const gradient = ctx.createLinearGradient(0, 0, 0, 500);
  gradient.addColorStop(0, "rgba(34,197,94,0.8)");
  gradient.addColorStop(1, "rgba(34,197,94,0.05)");
  return gradient;
}

// ✨ Glow Plugin
const glowPlugin = {
  id: 'glowEffect',
  beforeDatasetDraw(chart, args) {
    const { ctx } = chart;
    ctx.save();
    ctx.shadowColor = "rgba(34,197,94,0.6)";
    ctx.shadowBlur = 15;
    ctx.shadowOffsetX = 0;
    ctx.shadowOffsetY = 0;
  },
  afterDatasetDraw(chart, args) {
    chart.ctx.restore();
  }
};

Chart.register(glowPlugin);


function loadChart(days = 7) {

  document.querySelector(".chart-container").classList.add("loading");

  fetch(`/admin/chart-data?days=${days}`)
    .then(res => res.json())
    .then(data => {

      const labels = data.map(item =>
        new Date(item.day).toLocaleDateString("en-IN", {
          day: "2-digit",
          month: "short"
        })
      );

      const revenueData = data.map(item => item.revenue);
      const profitData = data.map(item => item.profit);
        const ordersData = data.map(item => item.orders);

      if (salesChart) {
        salesChart.destroy();
      }

      salesChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
  {
    type: 'bar',
    label: 'Revenue',
    data: revenueData,
    backgroundColor: "rgba(59,130,246,0.7)", 
    borderRadius: 8
  },
  {
    type: 'line',
    label: 'Profit',
    data: profitData,
    borderColor: "#16a34a", 
    backgroundColor: "rgba(34,197,94,0.2)",
    borderWidth: 4,
    tension: 0.4,
    fill: true,
    pointRadius: 5,
    pointBackgroundColor: "#ffffff",
    pointBorderColor: "#16a34a",
    pointBorderWidth: 2
  },
  {
    type: 'bar',
    label: 'Orders',
    data: data.map(item => item.orders),
    backgroundColor: "rgba(236,72,153,0.7)",
    borderRadius: 8
  }
]

        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 2000,
            easing: "easeOutQuart"
          },
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              labels: {
                font: { size: 14, weight: "bold" }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.dataset.label + ": ₹ " +
                         context.parsed.y.toLocaleString("en-IN");
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: value => "₹ " + value
              }
            }
          }
        }
      });

      document.querySelector(".chart-container").classList.remove("loading");
    });
}


loadChart(7);


document.getElementById("filterSelect").addEventListener("change", function() {
  loadChart(this.value);
});
</script>
<script>
function toggleNotifications() {
  document.getElementById("notificationDropdown").classList.toggle("show");
}

function loadNotifications() {
  fetch("/admin/notifications")
    .then(res => res.json())
    .then(data => {
      const dropdown = document.getElementById("notificationDropdown");
      const count = document.getElementById("notificationCount");

      dropdown.innerHTML = "";

      if (data.length === 0) {
        dropdown.innerHTML = "<p>No notifications</p>";
        count.textContent = 0;
        return;
      }

      count.textContent = data.length;

      data.forEach(n => {
        const div = document.createElement("div");
        div.classList.add("notification-item");

        div.innerHTML = `
          <p>${n.message}</p>
          <small>${new Date(n.created_at).toLocaleString()}</small>
        `;

        div.onclick = () => handleNotification(n);

        dropdown.appendChild(div);
      });
    });
}

function handleNotification(n) {

  fetch(`/admin/notifications/read/${n.id}`, {
    method: "POST"
  });

  
  if (n.type === "order") {
    window.location.href = "/admin/order";
  }

  else if (n.type === "wholesaler") {
    window.location.href = "/admin/wholesalers";
  }

  else if (n.type === "expired") {
    window.location.href = "/admin/products";
  }

  else if (n.type === "chat") {
    window.location.href = `/admin/chat/${n.related_id}`;
  }

    
  else if (n.type === "supply" && n.related_id) {
    window.location.href = "/admin/wholesalers";
  }
}

loadNotifications();
setInterval(loadNotifications, 5000);
</script>




</html>

