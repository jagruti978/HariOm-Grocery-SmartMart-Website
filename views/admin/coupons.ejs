<%- include("../partials/head", { title: "Manage Coupons" }) %>
<%- include("../partials/admin-header") %>

<style>
.product-wrapper {
  background: #fff;
  padding: 25px;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.product-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--green-main);
  margin-bottom: 20px;
}

.product-form {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 25px;
}

.product-form input,
.product-form select {
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid #ddd;
  font-size: 14px;
}

.product-form button {
  grid-column: span 3;
  width: fit-content;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  border-radius: 12px;
  overflow: hidden;
}

.admin-table th {
  background: var(--green-main);
  color: #fff;
  padding: 12px;
}

.admin-table td {
  padding: 12px;
  border-bottom: 1px solid #eee;
}

.action-btns {
  display: flex;
  gap: 8px;
}

.edit-btn {
  background: #549e94;
  padding: 7px 12px;
  border-radius: 8px;
  color: #fff;
  border: none;
}

.danger-btn {
  background: #e74c3c;
  padding: 7px 12px;
  border-radius: 8px;
  color: #fff;
  border: none;
}
</style>

<div class="container">
  <div class="product-wrapper">

    <h2 class="product-title">Manage Coupons</h2>

    
    <form
      class="product-form"
      method="POST"
      action="<%= editCoupon ? '/admin/coupons/update/' + editCoupon.coupon_id : '/admin/coupons/add' %>"
    >
      <input type="text" name="coupon_code" placeholder="Coupon Code"
        value="<%= editCoupon ? editCoupon.coupon_code : '' %>" required>

      <select name="discount_type" required>
        <option value="">Discount Type</option>
        <option value="percentage" <%= editCoupon && editCoupon.discount_type=='percentage'?'selected':'' %>>Percentage</option>
        <option value="flat" <%= editCoupon && editCoupon.discount_type=='flat'?'selected':'' %>>Flat</option>
      </select>

      <input type="number" step="0.01" name="discount_value" placeholder="Discount Value"
        value="<%= editCoupon ? editCoupon.discount_value : '' %>" required>

      <input type="date" name="start_date" value="<%= editCoupon ? editCoupon.start_date : '' %>" required>
      <input type="date" name="end_date" value="<%= editCoupon ? editCoupon.end_date : '' %>" required>

      <input type="number" name="per_customer_limit" placeholder="Per Customer Limit"
        value="<%= editCoupon ? editCoupon.per_customer_limit : '' %>">

      <% if(editCoupon){ %>
        <select name="status">
          <option value="active" <%= editCoupon.status=='active'?'selected':'' %>>Active</option>
          <option value="inactive" <%= editCoupon.status=='inactive'?'selected':'' %>>Inactive</option>
        </select>
      <% } %>

      <button class="pill-btn">
        <%= editCoupon ? 'Update Coupon' : 'Add Coupon' %>
      </button>
    </form>

   
    <table class="admin-table">
      <thead>
        <tr>
          <th>Code</th>
          <th>Type</th>
          <th>Value</th>
          <th>Validity</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% coupons.forEach(c => { %>
          <tr>
            <td><%= c.coupon_code %></td>
            <td><%= c.discount_type %></td>
            <td><%= c.discount_value %></td>
            <td>
  <%= new Date(c.start_date).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }) %>
  –
  <%= new Date(c.end_date).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  }) %>
</td>

            <td><%= c.status %></td>
            <td>
              <div class="action-btns">
                <a href="/admin/coupons/edit/<%= c.coupon_id %>" class="edit-btn">
                  <i class="fa-solid fa-pen"></i>
                </a>
                <form action="/admin/coupons/delete/<%= c.coupon_id %>" method="POST">
                  <button class="danger-btn">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  </div>
</div>
