<%- include("../partials/head", { title: "Chat Support" }) %>
<%- include("../partials/admin-header") %>

<!DOCTYPE html>
<html>
<head>
  <title>Admin Chats</title>
  <style>
    
 


    .chat-list {
      max-width: 600px;
      margin: 40px auto;
      background: #fff;
      border-radius: 8px;
       margin-top: 120px; 
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .chat-list h2 {
      background: #2f5d0a;
      color: #fff;
      padding: 15px;
      margin: 0;
    }

    .chat-user {
      padding: 15px;
      border-bottom: 1px solid #eee;
      cursor: pointer;
    }

    .chat-user:hover {
      background: #f5f5f5;
    }

    a {
      text-decoration: none;
      color: #000;
      font-weight: 600;
    }
  </style>
</head>
<body>



<div class="chat-list">
  <h2>Customer Chats</h2>

  <% if (customers.length === 0) { %>
    <div class="chat-user">No chats yet</div>
  <% } %>

<% customers.forEach(c => { %>
  <a href="/admin/chat/<%= c.user_id %>" style="display:block">
    <div class="chat-user">
      <%= c.name %>
    </div>
  </a>
<% }) %>

</div>

</body>
</html>
