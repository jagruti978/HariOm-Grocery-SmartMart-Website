<%- include("../partials/head", { title: "My Wishlist" }) %>

<style>

body { font-family: "Comfortaa", sans-serif; background-color: #d1bba6; margin:0; color:#3b3b3b;}
.top-bar { background:#f2c9cf; display:flex; justify-content:space-between; padding:12px 30px; align-items:center;}
.top-left { display:flex; align-items:center; gap:12px; }
.logo-img { height:45px; }
.brand-name { font-size:18px; font-weight:700; color:#3b6e22;}
.brand-sub { font-size:12px; color:#555;}
.top-right { display:flex; gap:12px; align-items:center; }
.nav-btn, .wishlist-btn { background:white; padding:8px 16px; border-radius:20px; font-weight:600; cursor:pointer; color:#3b6e22; transition:0.2s;}
.nav-btn:hover, .wishlist-btn:hover { background:#8fb24d; color:white;}
.logout-btn { background:#8fb24d; color:white; border:none; padding:8px 16px; border-radius:20px; cursor:pointer;}
table { width:100%; border-collapse:collapse; margin-top:30px;}
th, td { padding:12px; border:1px solid #ccc; text-align:center;}
.product-img { width:80px; height:80px; object-fit:contain;}
.add-more-btn { background:#8fb24d; color:white; border:none; padding:10px 18px; border-radius:8px; cursor:pointer; margin-top:15px;}

.cart-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 20px;
  background: #fff7f0;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

.cart-table th {
  background: #f2c9cf;
  padding: 14px;
  font-weight: 700;
  color: #2f5d0a;
  text-align: center;
}

.cart-table td {
  padding: 12px;
  border-bottom: 1px solid #ddd;
  text-align: center;
}

.cart-table tr:last-child td {
  border-bottom: none;
}

.cart-table img.product-img {
  width: 70px;
  height: 70px;
  object-fit: contain;
  background: white;
  padding: 6px;
  border-radius: 10px;
}

.add-to-cart-btn {
  background: #8fb24d;
  color: white;
  border: none;
  padding: 6px 12px;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
}
.add-to-cart-btn:hover {
  background: #2f5d0a;
}


</style>



<div class="top-bar">
  <div class="top-left">
    <img src="/image/Logo.png" class="logo-img">
    <div>
      <div class="brand-name">HariOm SmartMart</div>
      <div class="brand-sub">Digital Grocery & Supplies</div>
    </div>
  </div>

  <div class="top-right">
    <div class="nav-btn" onclick="location.href='/customer/dashboard'">Home</div>
    <div class="nav-btn" onclick="location.href='/customer/wishlist'">  <i class="fas fa-heart"></i>  Wishlist </div>
    <button class="logout-btn" onclick="location.href='/customer/logout'">Logout</button>
  </div>
</div>


<div style="margin-top: 20px;">
   <h2 class="cart-title">My Wishlist <i class="fas fa-heart"></i></h2> 
</div>
<div class="cart-container">
  

  <% if (items.length === 0) { %>
    <p style="text-align:center;">Your wishlist is empty</p>
    <div style="text-align:center; margin-top:15px;">
      <button class="add-more-btn" onclick="location.href='/customer/dashboard'">Continue - View Our products</button>
    </div>
  <% } else { %>
    <table class="cart-table">
      <tr>
        <th>Image</th>
        <th>Product</th>
        <th>Price</th>
        <th>Action</th>
      </tr>

      <% items.forEach(item => { %>
        <tr>
          <td><img src="/uploads/<%= item.product_image %>" class="product-img"></td>
          <td><%= item.product_name %></td>
          <td>₹<%= item.price %></td>
         <td>
  <button class="add-to-cart-btn" data-id="<%= item.product_id %>">Add to Cart</button> |
  <a href="/customer/wishlist/remove/<%= item.wishlist_id %>">Remove</a>
</td>

        </tr>
      <% }) %>
    </table>
  <% } %>
</div>
<script>document.querySelectorAll(".add-to-cart-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    const productId = btn.dataset.id;

    fetch("/customer/cart/add", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ productId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert("Added to cart ");
      } else if (data.message) {
        alert(data.message);
      } else {
        alert("Error adding to cart");
      }
    })
    .catch(err => console.error(err));
  });
});

</script>
