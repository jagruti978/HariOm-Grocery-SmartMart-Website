<%- include("../partials/head", { title: product.product_name }) %>


<style>
body {
  background: #f8f8f8;
  font-family: "Comfortaa", sans-serif;
}


.breadcrumb {
  padding: 20px 50px;
  font-size: 14px;
  color: #777;
}

.breadcrumb a {
  text-decoration: none;
  color: #3b6e22;
}

.detail-container {
  display: flex;
  gap: 60px;
  padding: 30px 50px;
}

.detail-image {
  flex: 1;
  width: 450px;
  height: 450px;      
  overflow: hidden;
  border-radius: 15px;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.4s ease;
}

.detail-image:hover img {
  transform: scale(1.4);
}

.detail-info {
  flex: 1;
}

.detail-name {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 15px;
}

.detail-price {
  font-size: 24px;
  color: #3b6e22;
  margin-bottom: 15px;
}

.detail-desc {
  margin-bottom: 20px;
  color: #555;
  line-height: 1.6;
}

/* Quantity */
.qty-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

.qty-box input {
  width: 60px;
  padding: 6px;
  text-align: center;
}


.add-btn {
  background: #3b6e22;
  color: white;
  border: none;
  padding: 12px 25px;
  border-radius: 25px;
  cursor: pointer;
  font-size: 16px;
}


.related-section {
  padding: 40px 50px;
}

.related-title {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 20px;
}

.related-grid {
  display: flex;
  gap: 20px;
}

.related-card {
  background: white;
  padding: 15px;
  border-radius: 12px;
  width: 180px;
  text-align: center;
}

.related-card img {
  width: 100%;
  height: 120px;
  object-fit: contain;
}

.top-bar { 
  background:#f2c9cf; 
  display:flex; 
  justify-content:space-between; 
  padding:12px 30px; 
  align-items:center;
}
.logo-img { height:45px; }
.brand-name { font-size:18px; font-weight:700; color:#3b6e22;}
.brand-sub { font-size:12px; color:#555;}
.nav-btn { 
  background:white; 
  padding:8px 16px; 
  border-radius:20px; 
  font-weight:600; 
  cursor:pointer; 
  color:#3b6e22; 
}
.logout-btn { 
  background:#8fb24d; 
  color:white; 
  border:none; 
  padding:8px 16px; 
  border-radius:20px; 
  cursor:pointer;
}


body {
  margin: 0;
  font-family: 'Comfortaa', sans-serif;
  min-height: 100vh;
  background-color: #efe4d6;
  position: relative;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image: url("/image/pattern.png");
  background-repeat: repeat;
  background-size: 220px;
  opacity: 0.09;
  z-index: 0;
  pointer-events: none;
}


.top-bar,
.detail-container,
.related-section,
.breadcrumb {
  position: relative;
  z-index: 5;
}
</style>

<div class="top-bar">
  <div class="top-left">
    <img src="/image/Logo.png" class="logo-img">
    <div>
      <div class="brand-name">HariOm SmartMart</div>
      <div class="brand-sub">Digital Grocery & Supplies</div>
    </div>
  </div>

  <div class="top-right">
    <div class="nav-btn" onclick="location.href='/customer/dashboard'">
      Home
    </div>
    <button class="logout-btn" onclick="location.href='/customer/logout'">
      Logout
    </button>
  </div>
</div>

<div class="breadcrumb">
  <a href="/customer/dashboard">Home</a> 
  > <%= product.product_name %>
</div>

<div class="detail-container">

  <div class="detail-image">
    <img src="/uploads/<%= product.product_image %>">
  </div>

  <div class="detail-info">
    <div class="detail-name"><%= product.product_name %></div>
    <div class="detail-price">₹<%= product.price %></div>

    <div class="detail-desc">
      <%= product.description || "No description available." %>
    </div>

    <div class="qty-box">
      Quantity:
      <input type="number" id="quantity" value="1" min="1">
    </div>

    <button class="add-btn" id="addToCartBtn">
      Add to Cart
    </button>
  </div>

</div>

<% if (relatedProducts.length) { %>
<div class="related-section">
  <div class="related-title">Related Products</div>

  <div class="related-grid">
    <% relatedProducts.forEach(r => { %>
      <div class="related-card">
        <a href="/customer/product/<%= r.product_id %>">
          <img src="/uploads/<%= r.product_image %>">
        </a>
        <div><%= r.product_name %></div>
        <div>₹<%= r.price %></div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<script>
document.getElementById("addToCartBtn").addEventListener("click", function() {

  const qty = document.getElementById("quantity").value;

  fetch("/customer/cart/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    credentials: "same-origin",
    body: JSON.stringify({ 
      productId: "<%= product.product_id %>",
      quantity: qty
    })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      alert("Added to cart ");
    } else {
      alert("Error adding product");
    }
  });

});
</script>