<%- include("../partials/head", { title: "Chat with Admin" }) %>
<!DOCTYPE html>
<html>
<head>
  <title>Chat with Admin</title>
 <style>
  
body { font-family: "Comfortaa", sans-serif; background-color: #d1bba6; margin:0; color:#3b3b3b;}
.top-bar { background:#f2c9cf; display:flex; justify-content:space-between; padding:12px 30px; align-items:center;}
.top-left { display:flex; align-items:center; gap:12px; }
.logo-img { height:45px; }
.brand-name { font-size:18px; font-weight:700; color:#3b6e22;}
.brand-sub { font-size:12px; color:#555;}
.top-right { display:flex; gap:12px; align-items:center; }
.nav-btn, .order-btn { background:white; padding:8px 16px; border-radius:20px; font-weight:600; cursor:pointer; color:#3b6e22; transition:0.2s;}
.nav-btn:hover, .order-btn:hover { background:#8fb24d; color:white;}
.logout-btn { background:#8fb24d; color:white; border:none; padding:8px 16px; border-radius:20px; cursor:pointer;}
table { width:100%; border-collapse:collapse; margin-top:30px;}
th, td { padding:12px; border:1px solid #ccc; text-align:center;}
.product-img { width:80px; height:80px; object-fit:contain;}
.add-more-btn { background:#8fb24d; color:white; border:none; padding:10px 18px; border-radius:8px; cursor:pointer; margin-top:15px;}


.chat-wrapper {
  max-width: 900px;
  margin: 30px auto;
  background: #fff;
  display: flex;
  flex-direction: column;
  height: 85vh;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}


.chat-header {
  background: #3b6e22;
  color: #fff;
  padding: 15px;
  font-weight: 600;
  font-size: 18px;
}


.chat-body {
  flex: 1;
  padding: 20px;
  background: #e5ddd5;
  overflow-y: auto;
}

.message {
  max-width: 60%;
  padding: 10px 14px;
  border-radius: 10px;
  margin-bottom: 12px;
  font-size: 14px;
  line-height: 1.4;
}

.sent {
  background: #f2c9cf;
  margin-left: auto;
  border-bottom-right-radius: 0;
}

.received {
  background: #fff;
  margin-right: auto;
  border-bottom-left-radius: 0;
}


.chat-footer {
  display: flex;
  padding: 12px;
  background: #f0f0f0;
}

.chat-footer input {
  flex: 1;
  padding: 10px;
  border-radius: 20px;
  border: 1px solid #ccc;
  outline: none;
}

.chat-footer button {
  margin-left: 10px;
  background: #3b6e22;
  color: white;
  border: none;
  border-radius: 50%;
  width: 45px;
  height: 45px;
  font-size: 18px;
  cursor: pointer;
}

 </style>
</head>
<body>

<div class="top-bar">
  <div class="top-left">
    <img src="/image/Logo.png" class="logo-img">
    <div>
      <div class="brand-name">HariOm SmartMart</div>
      <div class="brand-sub">Digital Grocery & Supplies</div>
    </div>
  </div>

  <div class="top-right">
    <div class="nav-btn" onclick="location.href='/customer/dashboard'">Home</div>
    <div class="nav-btn" onclick="location.href='/customer/chat'">
    <i class="fa-solid fa-comments"></i> Chat
    </div>
    <button class="logout-btn" onclick="location.href='/customer/logout'">Logout</button>
  </div>
</div>


<div class="chat-wrapper">
  <div class="chat-header">Admin Support</div>

  <div class="chat-body">
    <% chats.forEach(c => { %>
      <div class="message <%= c.sender_id === session.user.id ? 'sent' : 'received' %>">
        <%= c.message %>
      </div>
    <% }) %>
  </div>

  <form class="chat-footer" method="POST" action="/customer/chat/send">
    <input type="hidden" name="receiver_id" value="<%= adminId %>">
    <input type="text" name="message" placeholder="Type a message..." required>
    <button>➤</button>
  </form>
</div>

</body>
</html>
